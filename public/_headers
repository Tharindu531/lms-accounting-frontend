# Cloudflare Workers static-assets headers (Vite copies this file into dist/).
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# The CSP is report-only for now: check the browser console on the live site for
# "[Report Only]" violations (lessons, quizzes, PDF viewer, admin pages), then rename
# the header to Content-Security-Policy to enforce it. connect-src, img-src and
# frame-src allow https: because the API host (VITE_API_URL) and the R2 presigned-URL
# host differ per environment; narrow them to the real hosts once confirmed.
#
# Vite fingerprints every file under /assets, so those can be cached for a year.
# HTML keeps the Workers default (revalidate every time) so deploys show up at once.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https:; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
